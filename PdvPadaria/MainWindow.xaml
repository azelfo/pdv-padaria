<Window x:Class="PdvPadaria.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PDV - Padaria Venâncio" Icon="pack://application:,,,/Resources/app.ico" Height="800" Width="1350"
        MinHeight="768" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#060608"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowState="Maximized">

    <Window.Resources>

        <!-- Inputs Estilizados -->
        <Style x:Key="RoundedInputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Background" Value="{StaticResource BgSidebar}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botões de Métodos de Pagamento -->
        <Style x:Key="PaymentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Padding="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceHover}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Finalizar Venda -->
        <Style x:Key="FinishButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#10b981" Offset="0.0"/>
                        <GradientStop Color="#059669" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}" Padding="15"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="St" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#34d399" Offset="0.0"/>
                                            <GradientStop Color="#10b981" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="St" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.13"/>
                                            <DoubleAnimation Storyboard.TargetName="St" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.13"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="St" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13"/>
                                            <DoubleAnimation Storyboard.TargetName="St" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.13"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="St" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="St" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="St" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="St" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#26262e"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Lateral da Barra de Navegação -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="20,12,15,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderBack" CornerRadius="8" Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- Indicador vertical dourado lateral para o botão ativo -->
                                <Border x:Name="ActiveIndicator"
                                        Width="3.5"
                                        Background="{StaticResource Accent}"
                                        CornerRadius="1.75"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Margin="6,8,0,8"
                                        Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderBack" Property="Background" Value="{StaticResource Surface}"/>
                            </Trigger>
                            <!-- Ativo: code-behind seta Foreground ambar (#f59e0b) -->
                            <Trigger Property="Foreground" Value="#f59e0b">
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="BorderBack" Property="Background" Value="{StaticResource AccentTint}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de ComboBox Dark Premium -->
        <Style x:Key="PremiumComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#141419"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#26262e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          Background="{TemplateBinding Background}" 
                                          Grid.Column="2" 
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border CornerRadius="8" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                Padding="10,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" 
                                                      x:Name="Arrow" 
                                                      Fill="{StaticResource TextSubtle}" 
                                                      HorizontalAlignment="Right" 
                                                      VerticalAlignment="Center" 
                                                      Data="M 0 0 L 4 4 L 8 0 Z" 
                                                      Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="Arrow" Property="Fill" Value="#f59e0b"/>
                                                <Setter Property="BorderBrush" Value="#f59e0b"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="true">
                                                <Setter TargetName="Arrow" Property="Fill" Value="#f59e0b"/>
                                                <Setter Property="BorderBrush" Value="#f59e0b"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="12,3,12,3" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      Background="Transparent"
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#141419" 
                                            BorderBrush="#26262e" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Margin="0,3,0,0">
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de ComboBoxItem Dark Premium -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#141419"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" 
                                CornerRadius="6" 
                                Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#26262e"/>
                                <Setter Property="Foreground" Value="#f59e0b"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#26F59E0B"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de DatePicker Dark Premium -->
        <Style x:Key="PremiumDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="#141419"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#26262e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid x:Name="DatePickerRoot">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Border" 
                                    CornerRadius="8" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    Padding="2" 
                                    Grid.ColumnSpan="2"/>
                            
                            <DatePickerTextBox x:Name="PART_TextBox" 
                                               Grid.Column="0" 
                                               Focusable="true" 
                                               HorizontalContentAlignment="Center" 
                                               VerticalContentAlignment="Center" 
                                               Background="Transparent" 
                                               Foreground="#f8fafc" 
                                               BorderThickness="0"
                                               Margin="2"/>
                            
                            <Button x:Name="PART_Button" 
                                    Grid.Column="1" 
                                    Focusable="False" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Center" 
                                    Width="26" 
                                    Height="26" 
                                    Margin="0,0,4,0" 
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <Path Fill="{StaticResource TextSubtle}" 
                                                  Width="12"
                                                  Height="12"
                                                  Stretch="Fill"
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center" 
                                                  Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7v-5z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter Property="Foreground" Value="#f59e0b"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   Placement="Bottom" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   StaysOpen="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#f59e0b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <!-- Coluna 1: Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Coluna 2: Conteúdo -->
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR LATERAL (NAVEGAÇÃO E STATUS) -->
        <Border Background="#0a0a0c" BorderThickness="0,0,1,0" BorderBrush="#26262e">
            <Grid Margin="15,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Logo / Cabeçalho -->
                    <RowDefinition Height="*"/>
                    <!-- Botões de Menu -->
                    <RowDefinition Height="Auto"/>
                    <!-- Info do Operador / Rodapé -->
                </Grid.RowDefinitions>

                <!-- Logo / Marca -->
                <Image Source="pack://application:,,,/Resources/logo.png" Stretch="Uniform" Height="75" HorizontalAlignment="Center" Margin="0,5,0,30" RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Botões de Menu Lateral -->
                <StackPanel Grid.Row="1">
                    <!-- Frente de Caixa (PDV) -->
                    <Button x:Name="BtnPdv" Style="{StaticResource SidebarButton}" Margin="0,0,0,6" Click="SidebarBtn_Click" Tag="0" Background="#141419" Foreground="#f59e0b">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛒  " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Frente de Caixa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Estoque -->
                    <Button x:Name="BtnEstoque" Style="{StaticResource SidebarButton}" Margin="0,0,0,6" Click="SidebarBtn_Click" Tag="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦  " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Estoque Local" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Vendas / Histórico -->
                    <Button x:Name="BtnVendas" Style="{StaticResource SidebarButton}" Margin="0,0,0,6" Click="SidebarBtn_Click" Tag="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋  " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Histórico &amp; Canc." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Dashboard -->
                    <Button x:Name="BtnDashboard" Style="{StaticResource SidebarButton}" Margin="0,0,0,6" Click="SidebarBtn_Click" Tag="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊  " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Painel da Rede (somente DONO) -->
                    <Button x:Name="BtnRede" Style="{StaticResource SidebarButton}" Margin="0,0,0,6" Click="SidebarBtn_Click" Tag="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐  " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Painel da Rede" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Alertas de Estoque -->
                    <Button x:Name="BtnAlertas" Style="{StaticResource SidebarButton}" Margin="0,0,0,6" Click="SidebarBtn_Click" Tag="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚨  " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Alertas de Estoque" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Etiquetas (dono e atendente) -->
                    <Button x:Name="BtnEtiquetas" Style="{StaticResource SidebarButton}" Margin="0,0,0,6" Click="SidebarBtn_Click" Tag="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏷️  " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Etiquetas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Rodapé com informações e sincronização -->
                <Border Grid.Row="2" Background="{StaticResource Surface}" Margin="0,10,0,0" Padding="12" ToolTip="Informações do Operador" CornerRadius="8" Effect="{StaticResource ElevCard}">
                    <StackPanel>
                        <TextBlock Text="OPERADOR" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,2"/>
                        <TextBlock x:Name="OperatorNameText" Text="Aline Caixa" FontSize="13" FontWeight="Bold" Foreground="#f8fafc" Margin="0,0,0,10"/>

                        <Separator Background="#26262e" Margin="0,0,0,10"/>

                        <!-- Indicador Sincronização -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse x:Name="SyncStatusIndicator" Width="8" Height="8" Fill="#10b981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SyncStatusText" Text="Sincronizado" FontSize="11" Foreground="#94a3b8" TextTrimming="CharacterEllipsis" Width="140" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button x:Name="SyncButton" Content="Sincronizar Agora" Padding="8,5" FontSize="11" FontWeight="SemiBold"
                                Background="#060608" Foreground="#f8fafc" BorderBrush="#26262e" BorderThickness="1" Cursor="Hand" Click="SyncButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Sair do Sistema" Margin="0,8,0,0" Padding="8,5" FontSize="11" FontWeight="Bold"
                                Background="#ef4444" Foreground="#ffffff" BorderThickness="0" Cursor="Hand" Click="LogoutButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ÁREA PRINCIPAL COM TABCONTROL (ABAS OCULTAS) -->
        <TabControl x:Name="MainTabControl" Grid.Column="1" Background="Transparent" BorderThickness="0" Margin="25">
            <TabControl.Resources>
                <!-- Oculta as abas reais -->
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.Resources>

            <!-- ================= TAB 0: FRENTE DE CAIXA ================= -->
            <TabItem Header="PDV">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho Rápido -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FRENTE DE CAIXA" FontSize="20" FontWeight="Black" Foreground="{StaticResource PremiumTextGradient}" VerticalAlignment="Center"/>
                            <Border CornerRadius="4" Background="{StaticResource AccentBadge}" Padding="6,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="LOJA PRINCIPAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                            </Border>
                        </StackPanel>

                        <ToggleButton x:Name="KioskToggle" Grid.Column="1" Content="Modo Tela Cheia" Padding="10,5" FontSize="12" Cursor="Hand"
                                      Background="{StaticResource Surface}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Checked="KioskToggle_Checked" Unchecked="KioskToggle_Unchecked">
                            <ToggleButton.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </ToggleButton.Resources>
                        </ToggleButton>
                    </Grid>

                    <Grid Grid.Row="1">
                        <!-- MODO CONSULTA (Preço/Info do Produto) -->
                        <Grid x:Name="GridConsulta" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Barra de pesquisa da consulta -->
                            <Grid Margin="0,0,0,25" MaxWidth="700" HorizontalAlignment="Center" Width="700">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ConsultationSearchBox" Style="{StaticResource RoundedInputBox}"
                                         TextChanged="ConsultationSearchBox_TextChanged" KeyDown="ConsultationSearchBox_KeyDown" Height="50" FontSize="16" Padding="15,12"/>
                                <TextBlock x:Name="ConsultationPlaceholder" IsHitTestVisible="False" Text="Consulte por Nome ou Código de Barras (ou use o leitor)..."
                                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0" Foreground="{StaticResource TextSubtle}" FontSize="16"/>
                                <Button Grid.Column="1" Content="Consultar" Margin="10,0,0,0" Width="130" Style="{StaticResource ShortcutButton}" Height="50" FontSize="14" Click="ConsultationSearchButton_Click"/>

                                <!-- Sugestões de produto conforme digita (some ao usar o leitor). -->
                                <Popup x:Name="ConsultationSugestoesPopup" PlacementTarget="{Binding ElementName=ConsultationSearchBox}"
                                       Placement="Bottom" AllowsTransparency="True" StaysOpen="False" Width="700">
                                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                            CornerRadius="8" Margin="0,4,0,0" Effect="{StaticResource ElevCard}">
                                        <ListBox x:Name="ConsultationSugestoesList" Background="Transparent" BorderThickness="0"
                                                 MaxHeight="260" Foreground="{StaticResource TextPrimary}" FontSize="15"
                                                 MouseLeftButtonUp="ConsultationSugestoes_Click"/>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- Card de Detalhes do Produto -->
                            <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="16" BorderThickness="1" BorderBrush="{StaticResource BorderSoft}" Padding="40" MaxWidth="800" HorizontalAlignment="Center" VerticalAlignment="Center" Width="800" Effect="{StaticResource ElevCard}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📢 CONSULTOR DE PRODUTOS" Foreground="{StaticResource TextSubtle}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                                    <TextBlock x:Name="ConsultationProductName" Text="Passe um produto no leitor" Foreground="{StaticResource TextPrimary}" FontSize="36" FontWeight="Black" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,15"/>

                                    <TextBlock x:Name="ConsultationProductPrice" Text="R$ 0,00" Foreground="{StaticResource Accent}" FontSize="64" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                                    <Grid Width="400" Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ConsultationProductStock" Text="Estoque: --" Foreground="{StaticResource TextMuted}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ConsultationProductCategory" Grid.Column="1" Text="Categoria: --" Foreground="{StaticResource TextMuted}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Grid>

                                    <Border Background="{StaticResource BgBase}" CornerRadius="8" Padding="15,10" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Código de Barras: " Foreground="{StaticResource TextSubtle}" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock x:Name="ConsultationBarcode" Text="Aguardando leitura..." Foreground="#fcd34d" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Banner de Atalho para Iniciar Venda -->
                            <Border Grid.Row="2" Background="#26F59E0B" CornerRadius="10" Padding="25,15" Margin="0,20,0,0" MaxWidth="800" HorizontalAlignment="Center" Width="800">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Pronto para registrar vendas?" Foreground="#ffffff" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="Inicie o atendimento clicando no botão ao lado ou pressionando F1" Foreground="#fcd34d" FontSize="13" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="INICIAR VENDA (F1)" Padding="20,10" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="StartSaleButton_Click"
                                            Background="#f59e0b" Foreground="#060608" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- MODO VENDA ATIVA -->
                        <Grid x:Name="GridVenda" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LADO ESQUERDO: PESQUISA E ITENS DO CARRINHO -->
                            <Grid Margin="0,0,15,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Campo de busca -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SearchBox" Style="{StaticResource RoundedInputBox}"
                                             TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                                    
                                    <TextBlock x:Name="SearchPlaceholder" IsHitTestVisible="False" Text="Pesquise por Nome ou Código de Barras..."
                                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0,0,0" Foreground="{StaticResource TextSubtle}" FontSize="14"/>
                                    <Button Grid.Column="1" Content="Buscar" Margin="10,0,0,0" Width="100" Style="{StaticResource ShortcutButton}" Click="SearchButton_Click"/>

                                    <!-- Sugestões de produto conforme digita (some ao usar o leitor). -->
                                    <Popup x:Name="VendaSugestoesPopup" PlacementTarget="{Binding ElementName=SearchBox}"
                                           Placement="Bottom" AllowsTransparency="True" StaysOpen="False"
                                           Width="{Binding ActualWidth, ElementName=SearchBox}">
                                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                                CornerRadius="8" Margin="0,4,0,0" Effect="{StaticResource ElevCard}">
                                            <ListBox x:Name="VendaSugestoesList" Background="Transparent" BorderThickness="0"
                                                     MaxHeight="260" Foreground="{StaticResource TextPrimary}" FontSize="14"
                                                     MouseLeftButtonUp="VendaSugestoes_Click"/>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- Carrinho de Compras -->
                                <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderSoft}" Padding="15" Effect="{StaticResource ElevCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <Grid Margin="10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="PRODUTO" Style="{StaticResource TextHeader}"/>
                                            <TextBlock Grid.Column="1" Text="QTD" Style="{StaticResource TextHeader}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="PREÇO UNIT" Style="{StaticResource TextHeader}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="SUBTOTAL" Style="{StaticResource TextHeader}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="AÇÕES" Style="{StaticResource TextHeader}" HorizontalAlignment="Center"/>
                                        </Grid>

                                        <ListView x:Name="CartItemsList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="3*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ProductName}" Foreground="#f8fafc" FontSize="16" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding Details}" Foreground="#f59e0b" FontSize="12" Margin="0,2,0,0" FontWeight="SemiBold" Visibility="{Binding DetailsVisibility}"/>
                                                            
                                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding BoloVisibility}">
                                                                <Button Content="Fatia" FontSize="9" Padding="6,2" FontWeight="Bold" Background="#26262e" Foreground="#f8fafc" Cursor="Hand" Click="ChangeVariation_Click" Tag="{Binding CartItemId}" CommandParameter="NORMAL" Margin="0,0,5,0">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="CornerRadius" Value="4"/>
                                                                        </Style>
                                                                    </Button.Resources>
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Variation}" Value="NORMAL">
                                                                                    <Setter Property="Background" Value="#f59e0b"/>
                                                                                    <Setter Property="Foreground" Value="#060608"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Content="Bolo Inteiro" FontSize="9" Padding="6,2" FontWeight="Bold" Background="#26262e" Foreground="#f8fafc" Cursor="Hand" Click="ChangeVariation_Click" Tag="{Binding CartItemId}" CommandParameter="INTEIRO">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="CornerRadius" Value="4"/>
                                                                        </Style>
                                                                    </Button.Resources>
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Variation}" Value="INTEIRO">
                                                                                    <Setter Property="Background" Value="#f59e0b"/>
                                                                                    <Setter Property="Foreground" Value="#060608"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button Content="-" Width="20" Height="20" FontSize="11" FontWeight="Bold"
                                                                    Style="{StaticResource ShortcutButton}" Padding="0"
                                                                    Click="DecreaseQuantity_Click" Tag="{Binding CartItemId}" Margin="0,0,5,0"
                                                                    Visibility="{Binding NormalQuantityVisibility}"/>
                                                            <TextBlock Text="{Binding QuantityString}" Foreground="#fcd34d" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <Button Content="+" Width="20" Height="20" FontSize="11" FontWeight="Bold"
                                                                    Style="{StaticResource ShortcutButton}" Padding="0"
                                                                    Click="IncreaseQuantity_Click" Tag="{Binding CartItemId}" Margin="5,0,0,0"
                                                                    Visibility="{Binding NormalQuantityVisibility}"/>
                                                        </StackPanel>
                                                        
                                                        <TextBlock Grid.Column="2" Text="{Binding PriceUnitString}" Foreground="{StaticResource TextSubtle}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding SubtotalString}" Foreground="#fb923c" FontSize="18" FontWeight="ExtraBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="4" Content="Remover" Foreground="#f87171" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center" Click="RemoveItemButton_Click" Tag="{Binding CartItemId}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>

                                <!-- Atalhos rápidos -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                                    <Border CornerRadius="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="6,3" Margin="0,0,5,0">
                                        <TextBlock Text="[F12] Confirmar Venda" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </Border>
                                    <Border CornerRadius="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="6,3" Margin="0,0,5,0">
                                        <TextBlock Text="[F4] Lançar Pão" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </Border>
                                    <!-- A forma de pagamento é escolhida DEPOIS do F12, já na tela de
                                         fechamento. Antes esta barra anunciava [F5] Dinheiro, [F6] PIX e
                                         [F7] Cartão, teclas que nunca existiram no caixa: quem seguia a
                                         dica apertava e nada acontecia. -->
                                    <Border CornerRadius="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="6,3" Margin="0,0,5,0">
                                        <TextBlock Text="No pagamento: F1 Dinheiro · F2 PIX · F3 Cartão" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </Border>
                                    <Border CornerRadius="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="6,3" Margin="0,0,5,0">
                                        <TextBlock Text="[Esc] Voltar / Cancelar" FontSize="11" Foreground="{StaticResource DangerSoft}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- LADO DIREITO: TOTAIS E PAGAMENTO -->
                            <Grid Grid.Column="1" Margin="10,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Botão Lançar Pão -->
                                <Button x:Name="BtnLancarPao" Content="LANÇAR PÃO (F4)" Style="{StaticResource ShortcutButton}" Margin="0,0,0,15" Click="LaunchBreadButton_Click">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#f59e0b" Offset="0.0"/>
                                            <GradientStop Color="#b45309" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>

                                <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderSoft}" Padding="20" Margin="0,0,0,15" Effect="{StaticResource ElevCard}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="TOTAL A PAGAR" Foreground="{StaticResource TextSubtle}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TotalText" Text="R$ 0,00" Foreground="{StaticResource Accent}" FontSize="44" FontWeight="Black" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Área Dinâmica de Ações (Fim de Venda) -->
                                <Grid Grid.Row="2">
                                    <!-- Ação 1: Confirmar Venda (Modo Venda Ativa) -->
                                    <StackPanel x:Name="PanelPrecoVenda" Visibility="Visible">
                                        <Button x:Name="ConfirmSaleBtn" Content="CONFIRMAR VENDA (F12)" Style="{StaticResource FinishButton}" Click="ConfirmSaleBtn_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= TAB 1: ESTOQUE LOCAL ================= -->
            <TabItem Header="Estoque">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ESTOQUE LOCAL" FontSize="20" FontWeight="Black" Foreground="{StaticResource PremiumTextGradient}"/>
                            <TextBlock Text="Consulte o estoque físico e faça correções manuais de saldo" FontSize="12" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel x:Name="StockStorePanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0" Visibility="Collapsed">
                                <TextBlock Text="Loja:" Foreground="{StaticResource TextSubtle}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="StockStoreSelector" Style="{StaticResource PremiumComboBox}" Width="200" Height="34" SelectionChanged="StockStoreSelector_SelectionChanged"/>
                            </StackPanel>
                            <Button Content="+ Novo Produto" Style="{StaticResource ShortcutButton}" Margin="0,0,15,0" Click="AddProductButton_Click"/>
                            <Grid>
                                <TextBox x:Name="SearchStockBox" Width="250" Style="{StaticResource RoundedInputBox}" TextChanged="SearchStockBox_TextChanged"/>
                                <TextBlock x:Name="SearchStockPlaceholder" IsHitTestVisible="False" Text="Filtrar por nome..." VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource TextSubtle}" FontSize="13"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Filtros secundários: Comercial vs Produção Própria -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <Button x:Name="BtnFilterStockAll" Content="Todos os Produtos" Click="BtnFilterStockAll_Click" Style="{StaticResource ShortcutButton}" Width="160" Height="38" Padding="12,4" Margin="0,0,10,0" Background="{StaticResource Accent}" Foreground="{StaticResource BgBase}"/>
                        <Button x:Name="BtnFilterStockCommercial" Content="Produtos Comerciais" Click="BtnFilterStockCommercial_Click" Style="{StaticResource ShortcutButton}" Width="160" Height="38" Padding="12,4" Margin="0,0,10,0"/>
                        <Button x:Name="BtnFilterStockProduction" Content="Produção Própria" Click="BtnFilterStockProduction_Click" Style="{StaticResource ShortcutButton}" Width="160" Height="38" Padding="12,4"/>
                    </StackPanel>

                    <!-- Lista de Produtos e Estoques -->
                    <Border Grid.Row="2" Background="{StaticResource Surface}" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderSoft}" Padding="15" Effect="{StaticResource ElevCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="2.2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PRODUTO" Style="{StaticResource TextHeader}"/>
                                <TextBlock Grid.Column="1" Text="CÓD. BARRAS" Style="{StaticResource TextHeader}"/>
                                <TextBlock Grid.Column="2" Text="TIPO / MEDIDA" Style="{StaticResource TextHeader}"/>
                                <TextBlock Grid.Column="3" Text="CUSTO" Style="{StaticResource TextHeader}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="VENDA" Style="{StaticResource TextHeader}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="ESTOQUE" Style="{StaticResource TextHeader}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="6" Text="AÇÕES" Style="{StaticResource TextHeader}" HorizontalAlignment="Center"/>
                            </Grid>

                            <ListView x:Name="StockProductsList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="2.2*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Produto -->
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="#f8fafc" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding CategoryName}" Foreground="{StaticResource TextSubtle}" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Cód. Barras -->
                                            <TextBlock Grid.Column="1" Text="{Binding BarcodeString}" Foreground="#94a3b8" FontSize="13" VerticalAlignment="Center"/>

                                            <!-- Tipo / Medida -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Type}" Foreground="#94a3b8" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding UnitMeasure}" Foreground="{StaticResource TextSubtle}" FontSize="11" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- Custo -->
                                            <TextBlock Grid.Column="3" Text="{Binding PriceCostString}" Foreground="{StaticResource TextSubtle}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                            <!-- Venda -->
                                            <TextBlock Grid.Column="4" Text="{Binding PriceSaleString}" Foreground="#f8fafc" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                            <!-- Estoque -->
                                            <TextBlock Grid.Column="5" Text="{Binding StockString}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#10b981"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                <Setter Property="Foreground" Value="#ef4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Ações (Ajustar, Editar, Excluir) -->
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="Ajustar" Padding="8,4" FontSize="11" FontWeight="Bold" Margin="0,0,5,0"
                                                        Background="#26262e" Foreground="#f59e0b" BorderThickness="0" Cursor="Hand"
                                                        Click="AdjustStockButton_Click" Tag="{Binding Id}">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>

                                                <Button Content="Editar" Padding="8,4" FontSize="11" FontWeight="Bold" Margin="0,0,5,0"
                                                        Background="#26262e" Foreground="#60a5fa" BorderThickness="0" Cursor="Hand"
                                                        Click="EditProductButton_Click" Tag="{Binding Id}">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>

                                                <Button Content="Excluir" Padding="8,4" FontSize="11" FontWeight="Bold"
                                                        Background="#26ef4444" Foreground="#ef4444" BorderThickness="0" Cursor="Hand"
                                                        Click="DeleteProductButton_Click" Tag="{Binding Id}">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= TAB 2: HISTÓRICO E CANCELAMENTO ================= -->
            <TabItem Header="Vendas">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,15" Effect="{StaticResource ElevCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="HISTÓRICO DE VENDAS" FontSize="18" FontWeight="Black" Foreground="{StaticResource PremiumTextGradient}"/>
                                <TextBlock Text="Acompanhe e gerencie as vendas realizadas" FontSize="11" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Loja (somente DONO) -->
                                <StackPanel x:Name="HistoryStorePanel" Orientation="Horizontal" Margin="0,5,15,5" Visibility="Collapsed">
                                    <TextBlock Text="Loja:" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="HistoryStoreSelector" Style="{StaticResource PremiumComboBox}" Width="150" Height="32" SelectionChanged="HistoryStoreSelector_SelectionChanged"/>
                                </StackPanel>

                                <!-- Data Inicial -->
                                <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                    <TextBlock Text="De:" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"/>
                                    <DatePicker x:Name="HistoryStartDatePicker" Style="{StaticResource PremiumDatePicker}" Width="120" Height="32"/>
                                </StackPanel>

                                <!-- Data Final -->
                                <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                    <TextBlock Text="Até:" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"/>
                                    <DatePicker x:Name="HistoryEndDatePicker" Style="{StaticResource PremiumDatePicker}" Width="120" Height="32"/>
                                </StackPanel>

                                <!-- Horário -->
                                <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                    <TextBlock Text="Horário:" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBox x:Name="HistoryStartTimeTextBox" Text="00:00" Width="50" Height="32" VerticalAlignment="Center" Style="{StaticResource RoundedInputBox}" Padding="5,6" TextAlignment="Center" FontSize="12"/>
                                    <TextBlock Text="às" Foreground="#94a3b8" VerticalAlignment="Center" Margin="6,0,6,0" FontSize="12"/>
                                    <TextBox x:Name="HistoryEndTimeTextBox" Text="23:59" Width="50" Height="32" VerticalAlignment="Center" Style="{StaticResource RoundedInputBox}" Padding="5,6" TextAlignment="Center" FontSize="12"/>
                                </StackPanel>

                                <!-- Pagamento -->
                                <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                    <TextBlock Text="Pagamento:" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="HistoryPaymentFilterComboBox" Style="{StaticResource PremiumComboBox}" Width="120" Height="32" SelectedIndex="0">
                                        <ComboBoxItem Content="Todos" Tag="TODOS"/>
                                        <ComboBoxItem Content="Dinheiro" Tag="DINHEIRO"/>
                                        <ComboBoxItem Content="PIX" Tag="PIX"/>
                                        <ComboBoxItem Content="Cartão" Tag="CARTAO_CREDITO"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Botão Aplicar -->
                                <Button Content="Filtrar" Margin="0,5,0,5" Width="90" Height="32" Style="{StaticResource ShortcutButton}" Click="HistoryFilter_Click" Padding="10,2" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Lista de Vendas Realizadas -->
                    <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderSoft}" Padding="15" Effect="{StaticResource ElevCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DATA E HORA" Style="{StaticResource TextHeader}"/>
                                <TextBlock Grid.Column="1" Text="ID DA VENDA (CURTO)" Style="{StaticResource TextHeader}"/>
                                <TextBlock Grid.Column="2" Text="PAGAMENTO" Style="{StaticResource TextHeader}"/>
                                <TextBlock Grid.Column="3" Text="QTD ITENS" Style="{StaticResource TextHeader}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="VALOR TOTAL" Style="{StaticResource TextHeader}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource TextHeader}" HorizontalAlignment="Center"/>
                            </Grid>

                            <ListView x:Name="SalesHistoryList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SalesHistoryList_SelectionChanged">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#12f59e0b"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#26f59e0b"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,10" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Data -->
                                            <TextBlock Text="{Binding FormattedDate}" Foreground="#f8fafc" FontSize="13" VerticalAlignment="Center"/>

                                            <!-- ID -->
                                            <TextBlock Grid.Column="1" Text="{Binding ShortId}" Foreground="{StaticResource TextSubtle}" FontSize="13" VerticalAlignment="Center"/>

                                            <!-- Pagamento -->
                                            <TextBlock Grid.Column="2" Text="{Binding PaymentMethod}" Foreground="#94a3b8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                            <!-- Quantidade de itens -->
                                            <TextBlock Grid.Column="3" Text="{Binding ItemCountString}" Foreground="#fcd34d" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                            <!-- Valor Total -->
                                            <TextBlock Grid.Column="4" Text="{Binding TotalString}" Foreground="#f59e0b" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                            <!-- Status -->
                                            <Border Grid.Column="5" CornerRadius="4" Padding="6,3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#2610B981"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                                                <Setter Property="Background" Value="#26EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding PaymentStatus}" FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#10b981"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                                                    <Setter Property="Foreground" Value="#ef4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= TAB 3: DASHBOARD LOCAL ================= -->
            <TabItem Header="Dashboard">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Cabeçalho -->
                        <RowDefinition Height="Auto"/>
                        <!-- Cards Estatísticos -->
                        <RowDefinition Height="*"/>
                        <!-- Gráficos e Tabelas detalhadas -->
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,20" Effect="{StaticResource ElevCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PAINEL ANALÍTICO LOCAL" FontSize="18" FontWeight="Black" Foreground="{StaticResource PremiumTextGradient}"/>
                                <TextBlock Text="Estatísticas gerais de faturamento e desempenho" FontSize="11" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Data Inicial -->
                                <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                    <TextBlock Text="De:" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"/>
                                    <DatePicker x:Name="DashStartDatePicker" Style="{StaticResource PremiumDatePicker}" Width="120" Height="32"/>
                                </StackPanel>

                                <!-- Data Final -->
                                <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                    <TextBlock Text="Até:" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"/>
                                    <DatePicker x:Name="DashEndDatePicker" Style="{StaticResource PremiumDatePicker}" Width="120" Height="32"/>
                                </StackPanel>

                                <!-- Horário -->
                                <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                    <TextBlock Text="Horário:" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBox x:Name="DashStartTimeTextBox" Text="00:00" Width="50" Height="32" VerticalAlignment="Center" Style="{StaticResource RoundedInputBox}" Padding="5,6" TextAlignment="Center" FontSize="12"/>
                                    <TextBlock Text="às" Foreground="#94a3b8" VerticalAlignment="Center" Margin="6,0,6,0" FontSize="12"/>
                                    <TextBox x:Name="DashEndTimeTextBox" Text="23:59" Width="50" Height="32" VerticalAlignment="Center" Style="{StaticResource RoundedInputBox}" Padding="5,6" TextAlignment="Center" FontSize="12"/>
                                </StackPanel>

                                <!-- Pagamento -->
                                <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                    <TextBlock Text="Pagamento:" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="DashPaymentFilterComboBox" Style="{StaticResource PremiumComboBox}" Width="120" Height="32" SelectedIndex="0">
                                        <ComboBoxItem Content="Todos" Tag="TODOS"/>
                                        <ComboBoxItem Content="Dinheiro" Tag="DINHEIRO"/>
                                        <ComboBoxItem Content="PIX" Tag="PIX"/>
                                        <ComboBoxItem Content="Cartão" Tag="CARTAO_CREDITO"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Loja (Somente DONO) -->
                                <StackPanel x:Name="DashStorePanel" Orientation="Horizontal" Margin="0,5,15,5" Visibility="Collapsed">
                                    <TextBlock Text="Loja:" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="DashStoreSelector" Style="{StaticResource PremiumComboBox}" Width="140" Height="32" SelectedIndex="0"/>
                                </StackPanel>

                                <!-- Botão Aplicar -->
                                <Button Content="Filtrar" Margin="0,5,0,5" Width="90" Height="32" Style="{StaticResource ShortcutButton}" Click="DashFilter_Click" Padding="10,2" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Cards Métricas Principais (1x5, 5ª coluna = Lucro só DONO) -->
                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="DashProfitColumn" Width="0"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card Faturamento -->
                        <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Margin="0,0,10,0" Effect="{StaticResource ElevCard}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#141419" Offset="0.0"/>
                                    <GradientStop Color="#1d1d24" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border Height="3" Background="{StaticResource Accent}" CornerRadius="12,12,0,0" VerticalAlignment="Top"/>
                                <Border Padding="15" Margin="0,3,0,0">
                                    <StackPanel>
                                        <TextBlock Text="FATURAMENTO HOJE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="DashBillingText" Text="R$ 0,00" FontSize="26" FontWeight="Black" Foreground="{StaticResource Accent}"/>
                                        <TextBlock Text="Apenas vendas aprovadas" FontSize="11" Foreground="{StaticResource TextSubtle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card Vendas Realizadas -->
                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Margin="0,0,10,0" Effect="{StaticResource ElevCard}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#141419" Offset="0.0"/>
                                    <GradientStop Color="#1d1d24" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border Height="3" Background="{StaticResource Info}" CornerRadius="12,12,0,0" VerticalAlignment="Top"/>
                                <Border Padding="15" Margin="0,3,0,0">
                                    <StackPanel>
                                        <TextBlock Text="QUANTIDADE VENDAS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="DashSalesCountText" Text="0 vendas" FontSize="26" FontWeight="Black" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Exclui cupons cancelados" FontSize="11" Foreground="{StaticResource TextSubtle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card Ticket Médio -->
                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Margin="0,0,10,0" Effect="{StaticResource ElevCard}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#141419" Offset="0.0"/>
                                    <GradientStop Color="#1d1d24" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border Height="3" Background="{StaticResource Success}" CornerRadius="12,12,0,0" VerticalAlignment="Top"/>
                                <Border Padding="15" Margin="0,3,0,0">
                                    <StackPanel>
                                        <TextBlock Text="TICKET MÉDIO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="DashAvgTicketText" Text="R$ 0,00" FontSize="26" FontWeight="Black" Foreground="{StaticResource Success}"/>
                                        <TextBlock Text="Valor médio por compra" FontSize="11" Foreground="{StaticResource TextSubtle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card Cancelamentos -->
                        <Border Grid.Column="3" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Margin="0,0,10,0" Effect="{StaticResource ElevCard}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#141419" Offset="0.0"/>
                                    <GradientStop Color="#1d1d24" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border Height="3" Background="{StaticResource Danger}" CornerRadius="12,12,0,0" VerticalAlignment="Top"/>
                                <Border Padding="15" Margin="0,3,0,0">
                                    <StackPanel>
                                        <TextBlock Text="VENDAS CANCELADAS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="DashCanceledSalesText" Text="0 cupons" FontSize="26" FontWeight="Black" Foreground="{StaticResource Danger}"/>
                                        <TextBlock Text="Estornos efetuados" FontSize="11" Foreground="{StaticResource TextSubtle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card Lucro Bruto (somente DONO) -->
                        <Border x:Name="DashProfitCard" Grid.Column="4" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Effect="{StaticResource ElevCard}" Visibility="Collapsed">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#141419" Offset="0.0"/>
                                    <GradientStop Color="#1d1d24" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border Height="3" Background="#10b981" CornerRadius="12,12,0,0" VerticalAlignment="Top"/>
                                <Border Padding="15" Margin="0,3,0,0">
                                    <StackPanel>
                                        <TextBlock Text="LUCRO BRUTO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="DashProfitText" Text="R$ 0,00" FontSize="26" FontWeight="Black" Foreground="#10b981"/>
                                        <TextBlock Text="Faturamento − Custo" FontSize="11" Foreground="{StaticResource TextSubtle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Detalhamento: Métodos de Pagamento & Ranking de Produtos -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Caixa por Meio de Pagamento -->
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,15,0" Effect="{StaticResource ElevCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="CAIXA POR MÉTODO DE PAGAMENTO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15"/>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <!-- Dinheiro -->
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="💵 Dinheiro" FontSize="13" Foreground="#94a3b8" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DashCashAmountText" Text="R$ 0,00" FontSize="14" FontWeight="Bold" Foreground="#f8fafc" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Height="6" Background="#0a0a0c" Foreground="#f59e0b" BorderThickness="0" Value="100" Margin="0,0,0,15"/>

                                    <!-- PIX -->
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="📱 PIX" FontSize="13" Foreground="#94a3b8" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DashPixAmountText" Text="R$ 0,00" FontSize="14" FontWeight="Bold" Foreground="#f8fafc" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Height="6" Background="#0a0a0c" Foreground="#10b981" BorderThickness="0" Value="100" Margin="0,0,0,15"/>

                                    <!-- Cartão -->
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="💳 Cartão" FontSize="13" Foreground="#94a3b8" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DashCardAmountText" Text="R$ 0,00" FontSize="14" FontWeight="Bold" Foreground="#f8fafc" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Height="6" Background="#0a0a0c" Foreground="#60a5fa" BorderThickness="0" Value="100"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Ranking de Produtos Mais Vendidos de Hoje -->
                        <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Padding="20" Effect="{StaticResource ElevCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="PRODUTOS MAIS VENDIDOS HOJE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15"/>

                                <ListView x:Name="DashTopProductsList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Text="{Binding ProductName}" Foreground="#f8fafc" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding QuantityString}" Foreground="{StaticResource TextSubtle}" FontSize="13" Margin="20,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TotalString}" Foreground="#f59e0b" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= TAB 4: ALERTAS DE ESTOQUE CRÍTICO ================= -->
            <TabItem Header="Alertas">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Título e Sumário -->
                        <RowDefinition Height="Auto"/>
                        <!-- Cards de Resumo -->
                        <RowDefinition Height="*"/>
                        <!-- Listagem -->
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho -->
                    <Grid Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="ALERTAS DE ESTOQUE" FontSize="20" FontWeight="Black" Foreground="{StaticResource PremiumTextGradient}"/>
                            <TextBlock Text="Produtos que atingiram ou estão abaixo da quantidade mínima configurada no estoque" FontSize="12" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="AlertStorePanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Loja:" Foreground="{StaticResource TextSubtle}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="AlertStoreSelector" Style="{StaticResource PremiumComboBox}" Width="200" Height="34" SelectionChanged="AlertStoreSelector_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- Cards de Resumo -->
                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Itens Críticos -->
                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Margin="0,0,15,0" Effect="{StaticResource ElevCard}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#141419" Offset="0.0"/>
                                    <GradientStop Color="#1d1d24" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border Height="3" Background="#fb923c" CornerRadius="12,12,0,0" VerticalAlignment="Top"/>
                                <Border Padding="15" Margin="0,3,0,0">
                                    <StackPanel>
                                        <TextBlock Text="PRODUTOS ABAIXO DO MÍNIMO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="AlertLowStockCountText" Text="0 itens" FontSize="26" FontWeight="Black" Foreground="#fb923c"/>
                                        <TextBlock Text="Necessitam de reabastecimento" FontSize="11" Foreground="{StaticResource TextSubtle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card 2: Estoque Zerado -->
                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Margin="0,0,15,0" Effect="{StaticResource ElevCard}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#141419" Offset="0.0"/>
                                    <GradientStop Color="#1d1d24" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border Height="3" Background="{StaticResource Danger}" CornerRadius="12,12,0,0" VerticalAlignment="Top"/>
                                <Border Padding="15" Margin="0,3,0,0">
                                    <StackPanel>
                                        <TextBlock Text="PRODUTOS QUE ACABARAM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="AlertZeroStockCountText" Text="0 itens" FontSize="26" FontWeight="Black" Foreground="{StaticResource Danger}"/>
                                        <TextBlock Text="Já foram lançados e zeraram" FontSize="11" Foreground="{StaticResource TextSubtle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card 3: Total Ativos -->
                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Effect="{StaticResource ElevCard}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#141419" Offset="0.0"/>
                                    <GradientStop Color="#1d1d24" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border Height="3" Background="{StaticResource BorderSoft}" CornerRadius="12,12,0,0" VerticalAlignment="Top"/>
                                <Border Padding="15" Margin="0,3,0,0">
                                    <StackPanel>
                                        <TextBlock Text="SEM CONTAGEM INICIAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="AlertTotalCriticalCountText" Text="0 itens" FontSize="26" FontWeight="Black" Foreground="{StaticResource TextSubtle}"/>
                                        <TextBlock Text="Nunca tiveram estoque lançado" FontSize="11" Foreground="{StaticResource TextSubtle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Lista de Alertas -->
                    <Border Grid.Row="2" Background="{StaticResource Surface}" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderSoft}" Padding="15" Effect="{StaticResource ElevCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Cabeçalho da Lista -->
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PRODUTO" Style="{StaticResource TextHeader}"/>
                                <TextBlock Grid.Column="1" Text="CÓD. BARRAS" Style="{StaticResource TextHeader}"/>
                                <TextBlock Grid.Column="2" Text="TIPO / MEDIDA" Style="{StaticResource TextHeader}"/>
                                <TextBlock Grid.Column="3" Text="MÍNIMO" Style="{StaticResource TextHeader}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="ATUAL" Style="{StaticResource TextHeader}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="GRAVIDADE" Style="{StaticResource TextHeader}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="AÇÕES" Style="{StaticResource TextHeader}" HorizontalAlignment="Center"/>
                            </Grid>

                            <!-- Itens de Alerta -->
                            <ListView x:Name="StockAlertsList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Produto -->
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="#f8fafc" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding CategoryName}" Foreground="{StaticResource TextSubtle}" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Cód. Barras -->
                                            <TextBlock Grid.Column="1" Text="{Binding BarcodeString}" Foreground="#94a3b8" FontSize="13" VerticalAlignment="Center"/>

                                            <!-- Tipo / Medida -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Type}" Foreground="#94a3b8" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding UnitMeasure}" Foreground="{StaticResource TextSubtle}" FontSize="11" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- Mínimo -->
                                            <TextBlock Grid.Column="3" Text="{Binding MinStockString}" Foreground="#94a3b8" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                            <!-- Atual -->
                                            <TextBlock Grid.Column="4" Text="{Binding StockString}" Foreground="#ef4444" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                            <!-- Gravidade (Badge) -->
                                            <Border Grid.Column="5" CornerRadius="12" Padding="8,4" Background="{Binding BadgeBackground}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusAlerta}" Foreground="{Binding BadgeForeground}" FontSize="11" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Ações Rápidas -->
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="Repor" Padding="12,5" FontSize="11" FontWeight="Bold"
                                                        Background="#26262e" Foreground="#f59e0b" BorderThickness="0" Cursor="Hand"
                                                        Click="AdjustStockButton_Click" Tag="{Binding Id}">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ABA 5: PAINEL DA REDE (consolidado das lojas — DONO) -->
            <TabItem Header="Rede">
              <TabControl x:Name="RedeSubTabs" Background="Transparent" BorderThickness="0" SelectionChanged="RedeSubTabs_SelectionChanged">
                <TabControl.Resources>
                    <!-- Reverte o "ocultar abas" herdado do MainTabControl: aqui as abas DEVEM aparecer -->
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSubtle}"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="bd" Background="{StaticResource Surface}" CornerRadius="8" Padding="16,9" Margin="0,0,8,12">
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                            <Setter Property="Foreground" Value="#1a1205"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <DataTemplate x:Key="LojaDetalheTemplate">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">
                                <Grid Margin="0,0,0,16">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nome}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{Binding PeriodoText}" FontSize="13" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource DangerSoft}" FontSize="13" Margin="0,0,0,12" Visibility="{Binding StatusVisible}" TextWrapping="Wrap"/>

                                <UniformGrid Columns="2" Rows="2" Margin="0,0,0,16">
                                    <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="18" Margin="0,0,3,3" Effect="{StaticResource ElevCard}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FatString}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                            <TextBlock Text="FATURAMENTO" FontSize="10" Foreground="{StaticResource TextSubtle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="18" Margin="3,0,0,3" Effect="{StaticResource ElevCard}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding VendasString}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                            <TextBlock Text="VENDAS" FontSize="10" Foreground="{StaticResource TextSubtle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="18" Margin="0,3,3,0" Effect="{StaticResource ElevCard}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CanceladosString}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerSoft}"/>
                                            <TextBlock Text="CANCELAMENTOS" FontSize="10" Foreground="{StaticResource TextSubtle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="18" Margin="3,3,0,0" Effect="{StaticResource ElevCard}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding EstoqueString}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                            <TextBlock Text="ESTOQUE (PRODUTOS / EM FALTA)" FontSize="10" Foreground="{StaticResource TextSubtle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="18" Margin="0,0,0,14" Effect="{StaticResource ElevCard}" Visibility="{Binding TemAlerta}">
                                    <StackPanel>
                                        <TextBlock Text="⚠ ALERTA DE ESTOQUE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerSoft}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding EstoqueBaixo}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,6,0,6">
                                                        <TextBlock Text="{Binding Nome}" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding QtdMinString}" FontSize="13" Foreground="{StaticResource DangerSoft}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="18" Margin="0,0,0,14" Effect="{StaticResource ElevCard}">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO DE CANCELAMENTOS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Nenhum cancelamento no período." FontSize="13" Foreground="{StaticResource TextSubtle}" Visibility="{Binding SemCancelamentos}"/>
                                        <ItemsControl ItemsSource="{Binding Cancelamentos}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,7,0,7">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DataString}" FontSize="14" Foreground="{StaticResource TextPrimary}"/>
                                                            <TextBlock Text="{Binding Detalhe}" FontSize="12" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ValorString}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource DangerSoft}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </DataTemplate>
                </TabControl.Resources>
                <TabItem Header="📊 Geral">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <Grid Margin="0,0,0,18">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Painel da Rede" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Visão consolidada de todas as lojas" FontSize="13" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="RedeHojeBtn" Content="Hoje" Tag="0" Click="RedePeriodo_Click" Background="{StaticResource Accent}" Foreground="{StaticResource BgBase}" BorderThickness="0" Padding="16,8" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold" FontSize="13">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button x:Name="Rede7Btn" Content="7 dias" Tag="7" Click="RedePeriodo_Click" Background="{StaticResource Surface}" Foreground="{StaticResource TextSubtle}" BorderThickness="0" Padding="16,8" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold" FontSize="13">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button x:Name="Rede30Btn" Content="30 dias" Tag="30" Click="RedePeriodo_Click" Background="{StaticResource Surface}" Foreground="{StaticResource TextSubtle}" BorderThickness="0" Padding="16,8" Margin="0,0,14,0" Cursor="Hand" FontWeight="SemiBold" FontSize="13">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="↻ Atualizar" Click="RedeRefresh_Click" Background="{StaticResource Surface}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="16,8" Cursor="Hand" FontWeight="SemiBold" FontSize="13">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="RedeStatus" Text="" Foreground="{StaticResource DangerSoft}" FontSize="13" Margin="0,0,0,12" Visibility="Collapsed" TextWrapping="Wrap"/>

                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="18" Margin="0,0,6,0" Effect="{StaticResource ElevCard}">
                                <StackPanel>
                                    <TextBlock x:Name="RedeFat" Text="—" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                    <TextBlock Text="FATURAMENTO" FontSize="10" Foreground="{StaticResource TextSubtle}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="18" Margin="3,0,3,0" Effect="{StaticResource ElevCard}">
                                <StackPanel>
                                    <TextBlock x:Name="RedeVendas" Text="—" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                    <TextBlock Text="VENDAS" FontSize="10" Foreground="{StaticResource TextSubtle}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="18" Margin="6,0,0,0" Effect="{StaticResource ElevCard}">
                                <StackPanel>
                                    <TextBlock x:Name="RedeLojas" Text="—" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                    <TextBlock Text="LOJAS" FontSize="10" Foreground="{StaticResource TextSubtle}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="18" Margin="0,0,0,14" Effect="{StaticResource ElevCard}">
                            <StackPanel>
                                <TextBlock Text="POR LOJA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="RedeLojasList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,8,0,8">
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Nome}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                        <Border Background="{StaticResource DangerBadge}" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" Visibility="{Binding TemAlerta}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AlertaText}" FontSize="11" Foreground="{StaticResource DangerSoft}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Resumo}" FontSize="12" Foreground="{StaticResource TextSubtle}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding FatString}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="18" Effect="{StaticResource ElevCard}">
                            <StackPanel>
                                <TextBlock Text="MAIS VENDIDOS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="RedeTopList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Nome}" FontSize="14" Foreground="{StaticResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding QtdString}" FontSize="12" Foreground="{StaticResource TextSubtle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding FatString}" FontSize="14" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                </TabItem>
              </TabControl>
            </TabItem>

            <!-- ABA 6: ETIQUETAS (impressão de código de barras) -->
            <TabItem Header="Etiquetas">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Coluna esquerda: seleção do produto -->
                    <Border Grid.Column="0" Background="{StaticResource Surface}" CornerRadius="12" Padding="18" Effect="{StaticResource ElevCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Imprimir Etiquetas" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Escolha o produto, a quantidade e imprima o código de barras." FontSize="12" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <TextBox x:Name="EtqSearchBox" Style="{StaticResource RoundedInputBox}" Padding="10,8" FontSize="14"
                                         TextChanged="EtqSearchBox_TextChanged"/>
                                <TextBlock x:Name="EtqSearchPlaceholder" IsHitTestVisible="False" Text="Buscar produto por nome ou código..."
                                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"
                                           Foreground="{StaticResource TextSubtle}" FontSize="14"/>
                            </Grid>

                            <ListView x:Name="EtqProductsList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="EtqProductsList_SelectionChanged">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgBase}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0">
                                                    <Run Text="Cód: "/><Run Text="{Binding BarcodeDisplay, Mode=OneWay}"/>
                                                    <Run Text="   •   "/><Run Text="{Binding PriceDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Coluna direita: pré-visualização + impressão -->
                    <Border Grid.Column="2" Background="{StaticResource Surface}" CornerRadius="12" Padding="18" Effect="{StaticResource ElevCard}">
                        <StackPanel>
                            <TextBlock Text="Etiqueta" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                            <!-- Preview da etiqueta -->
                            <Border x:Name="EtqPreviewCard" Background="White" CornerRadius="6" Padding="8" HorizontalAlignment="Center"
                                    Width="200" Height="120" Margin="0,0,0,16">
                                <StackPanel x:Name="EtqPreviewContent" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="EtqPreviewName" Text="Selecione um produto" FontSize="12" FontWeight="Bold"
                                               Foreground="Black" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <Image x:Name="EtqPreviewBarcode" Height="52" Margin="0,4,0,2" Stretch="Uniform"/>
                                    <TextBlock x:Name="EtqPreviewCode" Text="" FontSize="10" Foreground="Black" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="EtqPreviewPrice" Text="" FontSize="13" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Produto vendido por PESO: atendente digita o peso lido na balança
                                 e o sistema calcula o preço (peso x preço do quilo cadastrado). -->
                            <Border x:Name="EtqPesoPanel" Visibility="Collapsed" Background="{StaticResource BgBase}"
                                    CornerRadius="8" Padding="12" Margin="0,0,0,12"
                                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="EtqPrecoKgInfo" Text="" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Peso lido na balança (kg)" FontSize="12" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="EtqPesoBox" Style="{StaticResource RoundedInputBox}" Padding="10,8" FontSize="16"
                                             TextChanged="EtqPesoBox_TextChanged"/>
                                    <TextBlock x:Name="EtqPesoTotal" Text="" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <CheckBox x:Name="EtqMostrarPreco" Content="Mostrar preço na etiqueta" IsChecked="True"
                                      Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" Checked="EtqPreco_Changed" Unchecked="EtqPreco_Changed"/>

                            <TextBlock Text="Quantidade de etiquetas" FontSize="12" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,4"/>
                            <TextBox x:Name="EtqQuantidade" Text="1" Style="{StaticResource RoundedInputBox}" Padding="10,8" FontSize="16" Margin="0,0,0,16"/>

                            <Button x:Name="EtqImprimirBtn" Content="Imprimir" Style="{StaticResource ShortcutButton}" Height="44"
                                    Click="EtqImprimir_Click" IsEnabled="False"/>

                            <TextBlock x:Name="EtqStatus" Text="" FontSize="12" Foreground="{StaticResource TextSubtle}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
