<Application x:Class="PdvPadaria.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:PdvPadaria">
    <Application.Resources>

        <!-- =========================================================
             DESIGN SYSTEM — Padaria Premium PDV
             Fonte unica de tokens. Mesmos valores de cor ja usados no
             app (mantem identidade); centralizados para consistencia.
             ========================================================= -->

        <!-- ===== COR: superficies ===== -->
        <SolidColorBrush x:Key="BgBase"      Color="#060608"/>  <!-- fundo app -->
        <SolidColorBrush x:Key="BgSidebar"   Color="#0A0A0C"/>  <!-- sidebar / inputs foco -->
        <SolidColorBrush x:Key="Surface"     Color="#141419"/>  <!-- cards / botoes -->
        <SolidColorBrush x:Key="SurfaceHover" Color="#1C1C23"/> <!-- hover elevado -->

        <!-- ===== COR: bordas ===== -->
        <SolidColorBrush x:Key="BorderSoft"   Color="#26262E"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#33333D"/>

        <!-- ===== COR: marca / ambar ===== -->
        <SolidColorBrush x:Key="Accent"      Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FBBF24"/>
        <SolidColorBrush x:Key="AccentTint"  Color="#1FF59E0B"/> <!-- fill ativo sutil -->
        <SolidColorBrush x:Key="AccentBadge" Color="#26F59E0B"/> <!-- badge/realce -->
        <SolidColorBrush x:Key="DangerBadge" Color="#33EF4444"/> <!-- badge perigo/alerta -->

        <!-- ===== COR: texto ===== -->
        <SolidColorBrush x:Key="TextPrimary"   Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CBD5E1"/> <!-- corpo: melhor contraste AA -->
        <SolidColorBrush x:Key="TextMuted"     Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextSubtle"    Color="#717F96"/> <!-- labels; AA-corrigido (era #64748B, reprovava AA normal) -->

        <!-- ===== COR: estado ===== -->
        <SolidColorBrush x:Key="Success"     Color="#10B981"/>
        <SolidColorBrush x:Key="SuccessDark" Color="#059669"/>
        <SolidColorBrush x:Key="Danger"      Color="#EF4444"/>
        <SolidColorBrush x:Key="DangerDark"  Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerSoft"  Color="#F87171"/> <!-- texto vermelho claro -->
        <SolidColorBrush x:Key="Info"        Color="#3B82F6"/>
        <SolidColorBrush x:Key="InfoLight"   Color="#60A5FA"/>

        <!-- ===== COR: acentos quentes (laranja/amarelo) ===== -->
        <SolidColorBrush x:Key="AccentOrange" Color="#FB923C"/> <!-- subtotal, alerta baixo -->
        <SolidColorBrush x:Key="AccentLight"  Color="#FCD34D"/> <!-- amarelo claro / qtd -->
        <SolidColorBrush x:Key="TextFaint"    Color="#6B7A91"/> <!-- rodape; AA-corrigido (era #475569, reprovava AA) -->

        <!-- ===== ESCALA: raio de canto ===== -->
        <CornerRadius x:Key="RadiusSm">4</CornerRadius>
        <CornerRadius x:Key="RadiusMd">8</CornerRadius>
        <CornerRadius x:Key="RadiusLg">12</CornerRadius>

        <!-- ===== ELEVACAO: sombra de card ===== -->
        <DropShadowEffect x:Key="ElevCard" BlurRadius="18" ShadowDepth="3"
                          Direction="270" Color="#000000" Opacity="0.45"/>

        <!-- =========================================================
             TIPOGRAFIA — escala consistente (TextBlock keyed)
             ========================================================= -->
        <Style x:Key="Type.Display" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Black"/>
        </Style>
        <Style x:Key="Type.H1" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="Type.H2" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Type.Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Type.Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Type.Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ===== GRADIENTE: título premium (dourado→laranja) ===== -->
        <LinearGradientBrush x:Key="PremiumTextGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#fcd34d" Offset="0.0"/>
            <GradientStop Color="#fb923c" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ===== ESTILO: cabeçalho de coluna em listas ===== -->
        <Style x:Key="TextHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ===== ESTILO: botão de atalho padrão do PDV ===== -->
        <Style x:Key="ShortcutButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="St" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceHover}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="St" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="St" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="St" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="St" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================================================
             LINHA DE LISTA — implicito p/ todo ListViewItem.
             Divisoria sutil + hover (remove highlight azul padrao do WPF).
             ========================================================= -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BgSidebar}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource Surface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
