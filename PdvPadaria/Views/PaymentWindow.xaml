<Window x:Class="PdvPadaria.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fechamento de Venda - Padaria Venâncio" Icon="pack://application:,,,/Resources/app.ico" 
        Width="520" Height="500"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <Border Background="#121216" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Effect="{StaticResource ElevCard}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <!-- Cabeçalho -->
                <RowDefinition Height="Auto"/>
                <!-- Conteúdo Dinâmico (Selection, Cash, Pix, Card) -->
                <RowDefinition Height="*"/>
                <!-- Rodapé (Dicas / Atalhos) -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Cabeçalho -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="FECHAMENTO DE VENDA" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="✕" Foreground="{StaticResource TextMuted}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" FontSize="18" Cursor="Hand" Click="CloseButton_Click"/>
            </Grid>

            <!-- 2. Conteúdo Dinâmico -->
            <Grid Grid.Row="1">
                
                <!-- TELA DE SELEÇÃO INICIAL (F1, F2, F3) -->
                <Grid x:Name="SelectionGrid" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Total da Venda -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,25">
                        <TextBlock Text="TOTAL A PAGAR" Foreground="{StaticResource TextSubtle}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TotalVendaText" Text="R$ 0,00" Foreground="{StaticResource TextPrimary}" FontSize="42" FontWeight="Black" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Botões Grandes de Opção -->
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,10">
                        <!-- Dinheiro -->
                        <Button x:Name="BtnSelectCash" Click="BtnSelectCash_Click" Margin="5" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="10">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="💵" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="White"/>
                                            <TextBlock Text="DINHEIRO" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <Border Background="{StaticResource AccentBadge}" CornerRadius="4" Padding="6,3" Margin="0,8,0,0" HorizontalAlignment="Center">
                                                <TextBlock Text="F1" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <!-- Pix -->
                        <Button x:Name="BtnSelectPix" Click="BtnSelectPix_Click" Margin="5" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="10">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="📱" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="White"/>
                                            <TextBlock Text="PIX" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <Border Background="{StaticResource AccentBadge}" CornerRadius="4" Padding="6,3" Margin="0,8,0,0" HorizontalAlignment="Center">
                                                <TextBlock Text="F2" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <!-- Cartão -->
                        <Button x:Name="BtnSelectCard" Click="BtnSelectCard_Click" Margin="5" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="10">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="💳" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="White"/>
                                            <TextBlock Text="CARTÃO" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <Border Background="{StaticResource AccentBadge}" CornerRadius="4" Padding="6,3" Margin="0,8,0,0" HorizontalAlignment="Center">
                                                <TextBlock Text="F3" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </UniformGrid>
                </Grid>

                <!-- FLUXO DINHEIRO -->
                <Grid x:Name="CashGrid" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="PAGAMENTO EM DINHEIRO" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                        
                        <!-- Total da Venda Compacto -->
                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="Total da Venda:" Foreground="{StaticResource TextMuted}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CashTotalText" Text="R$ 0,00" Foreground="{StaticResource TextPrimary}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Input Valor Recebido -->
                        <TextBlock Text="VALOR RECEBIDO (R$)" Foreground="{StaticResource TextSubtle}" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox x:Name="CashReceivedInput" 
                                 Height="45" 
                                 FontSize="24" 
                                 FontWeight="Bold"
                                 Foreground="{StaticResource TextPrimary}" 
                                 Background="{StaticResource Surface}" 
                                 BorderBrush="{StaticResource BorderSoft}" 
                                 BorderThickness="1" 
                                 Padding="10,8" 
                                 VerticalContentAlignment="Center"
                                 TextChanged="CashReceivedInput_TextChanged"/>
                        
                        <!-- Painel Troco -->
                        <Border Background="#1a10b981" BorderBrush="{StaticResource Success}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,15,0,20">
                            <Grid>
                                <TextBlock Text="Troco a Devolver:" Foreground="{StaticResource Success}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TrocoText" Text="R$ 0,00" Foreground="{StaticResource TextPrimary}" FontSize="28" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Botão Finalizar -->
                        <Button x:Name="FinishCashBtn" 
                                Content="FINALIZAR VENDA (Enter)" 
                                Height="45" 
                                FontSize="16" 
                                FontWeight="Bold" 
                                Foreground="White"
                                Background="{StaticResource Success}" 
                                BorderThickness="0" 
                                Cursor="Hand" 
                                Click="FinishCashBtn_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource Success}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="{StaticResource BorderStrong}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSubtle}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- FLUXO PIX -->
                <Grid x:Name="PixGrid" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0">
                        <TextBlock Text="📱 PAGAMENTO VIA PIX" Foreground="{StaticResource InfoLight}" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                        
                        <Border Background="#1a3b82f6" BorderBrush="{StaticResource Info}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20" Width="380">
                            <StackPanel>
                                <TextBlock Text="👉 INSTRUÇÕES PARA O OPERADOR:" Foreground="#3b82f6" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="1. Vá para a maquininha física e digite o valor da venda." Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <TextBlock Text="2. Realize a transação PIX com o cliente." Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <TextBlock Text="3. Apenas após o pagamento ser APROVADO na maquininha, clique no botão confirmar abaixo." Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                
                                <Border Background="#1affef3e" BorderBrush="#ffef3e" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,10,0,0">
                                    <TextBlock Text="⚠️ AVISO CRÍTICO: Não confirme sem a aprovação física na maquininha!" Foreground="#ffef3e" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Área de Confirmação / Carregamento -->
                        <Grid Margin="0,10,0,0">
                            <!-- Loader (Exibido durante o delay de 20s) -->
                            <StackPanel x:Name="PixLoaderPanel" Visibility="Visible" HorizontalAlignment="Center">
                                <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                    <Ellipse Stroke="#26262e" StrokeThickness="4"/>
                                    <Ellipse Stroke="#f59e0b" StrokeThickness="4" StrokeDashArray="3 1" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="RotatorPix" Angle="0"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RotatorPix" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </Grid>
                                <TextBlock x:Name="TxtPixCountdown" Text="Aguarde o processamento na maquininha... (20s)" Foreground="{StaticResource TextSubtle}" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Botão Confirmar (Ocultado durante o delay) -->
                            <Button x:Name="FinishPixBtn" 
                                    Content="Confirmar Recebimento (Enter)" 
                                    Width="300"
                                    Height="45" 
                                    FontSize="16" 
                                    FontWeight="Bold" 
                                    Foreground="White"
                                    Background="{StaticResource Success}" 
                                    BorderThickness="0" 
                                    Cursor="Hand" 
                                    Click="ConfirmPayment_Click"
                                    Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- FLUXO CARTÃO -->
                <Grid x:Name="CardGrid" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0">
                        <TextBlock Text="💳 PAGAMENTO VIA CARTÃO" Foreground="{StaticResource InfoLight}" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                        
                        <Border Background="#1a3b82f6" BorderBrush="{StaticResource Info}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20" Width="380">
                            <StackPanel>
                                <TextBlock Text="👉 INSTRUÇÕES PARA O OPERADOR:" Foreground="#3b82f6" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="1. Vá para a maquininha física e digite o valor da venda." Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <TextBlock Text="2. Insira ou aproxime o cartão do cliente." Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <TextBlock Text="3. Apenas após o pagamento ser APROVADO na maquininha, clique no botão confirmar abaixo." Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                
                                <Border Background="#1affef3e" BorderBrush="#ffef3e" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,10,0,0">
                                    <TextBlock Text="⚠️ AVISO CRÍTICO: Não confirme sem a aprovação física na maquininha!" Foreground="#ffef3e" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Área de Confirmação / Carregamento -->
                        <Grid Margin="0,10,0,0">
                            <!-- Loader (Exibido durante o delay de 20s) -->
                            <StackPanel x:Name="CardLoaderPanel" Visibility="Visible" HorizontalAlignment="Center">
                                <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                    <Ellipse Stroke="#26262e" StrokeThickness="4"/>
                                    <Ellipse Stroke="#f59e0b" StrokeThickness="4" StrokeDashArray="3 1" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="RotatorCard" Angle="0"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RotatorCard" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </Grid>
                                <TextBlock x:Name="TxtCardCountdown" Text="Aguarde o processamento na maquininha... (20s)" Foreground="{StaticResource TextSubtle}" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Botão Confirmar (Ocultado durante o delay) -->
                            <Button x:Name="FinishCardBtn" 
                                    Content="Confirmar Recebimento (Enter)" 
                                    Width="300"
                                    Height="45" 
                                    FontSize="16" 
                                    FontWeight="Bold" 
                                    Foreground="White"
                                    Background="{StaticResource Success}" 
                                    BorderThickness="0" 
                                    Cursor="Hand" 
                                    Click="ConfirmPayment_Click"
                                    Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </Grid>

            </Grid>

            <!-- 3. Rodapé com Atalhos -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                    <Grid>
                        <TextBlock Text="Pressione [Esc] para voltar ou cancelar" Foreground="{StaticResource TextSubtle}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Padaria Venâncio" Foreground="{StaticResource TextFaint}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
