# MODELO de configuracao do caixa (PDV).
#
# Este arquivo NAO contem segredos: ele e o molde que vai dentro do instalador.
# Na primeira instalacao ele e copiado como ".env". Em atualizacoes ele nunca
# sobrescreve o .env existente.

SUPABASE_URL=
SUPABASE_ANON_KEY=

TENANT_ID=

# Nome deste caixa, so para identificar a venda no historico (ex.: Caixa 1, Caixa 2).
TERMINAL_NAME=Caixa 1


# =====================================================================
# QUAL LOJA E ESTE CAIXA  --  nao precisa preencher nada aqui embaixo
# =====================================================================
#
# A maquina descobre a loja sozinha, no primeiro login feito com internet:
# o usuario do caixa (ex.: japao@padaria.com) ja tem a loja no cadastro, e o
# servidor entrega a esta maquina uma credencial propria, guardada fora desta
# pasta. Nao ha segredo para digitar.
#
# Se o caixa avisar na abertura que nao esta ligado a nenhuma loja: confira a
# internet, feche, abra e entre com o usuario DAQUELA loja. So isso.
#
# As duas linhas abaixo existem so por compatibilidade com maquinas antigas,
# configuradas antes disso. Deixe VAZIAS numa instalacao nova.
#
# ATENCAO se for preencher mesmo assim: as duas tem que ser da MESMA loja.
# Ate 20/08/2026 elas eram independentes -- o token decidia onde a venda caia
# e o STORE_ID decidia que estoque aparecia na tela -- e uma maquina com as
# duas trocadas vendia por uma loja mostrando o estoque de outra, sem erro
# nenhum. Hoje o token vence a disputa e o caixa avisa se discordarem.

STORE_SYNC_TOKEN=
STORE_ID=
