# MODELO de configuracao do caixa (PDV).
#
# Este arquivo NAO contem segredos: ele e o molde que vai dentro do instalador.
# Na primeira instalacao ele e copiado como ".env" e precisa ser preenchido com
# os dados DESTA loja. Em atualizacoes ele nunca sobrescreve o .env existente.
#
# Sao as chaves que o app le (Services/EnvService.cs). Nao adicione segredo
# aqui: este arquivo e versionado e vai dentro do instalador publico.

SUPABASE_URL=
SUPABASE_ANON_KEY=

TENANT_ID=

# QUAL LOJA E ESTE CAIXA
#
# STORE_SYNC_TOKEN e o unico valor que define a loja. O servidor descobre a loja
# a partir dele, tanto para gravar (venda, estoque) quanto para o proprio caixa
# saber que estoque mostrar. Cada loja tem o SEU token: dois caixas de lojas
# diferentes com o mesmo token fazem as vendas das duas cairem na mesma loja.
STORE_SYNC_TOKEN=

# STORE_ID e OPCIONAL. Serve so de socorro na primeira abertura de uma maquina
# recem-instalada que ainda nao conseguiu falar com a nuvem nenhuma vez. Depois
# disso o proprio caixa guarda a loja descoberta pelo token e ignora esta linha.
#
# Ate 20/08/2026 esta linha valia tanto quanto o token, e as duas podiam apontar
# para lojas diferentes: o caixa vendia por uma loja e mostrava o estoque de
# outra, sem erro na tela. Se preencher, use a MESMA loja do token.
STORE_ID=

# Nome deste caixa, so para identificar a venda no historico (ex.: Caixa 1, Caixa 2).
TERMINAL_NAME=Caixa 1
