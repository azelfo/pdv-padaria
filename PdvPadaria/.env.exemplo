# MODELO de configuracao do caixa (PDV).
#
# Este arquivo NAO contem segredos: ele e o molde que vai dentro do instalador.
# Na primeira instalacao ele e copiado como ".env" e precisa ser preenchido com
# os dados DESTA loja. Em atualizacoes ele nunca sobrescreve o .env existente.
#
# Sao exatamente as 6 chaves que o app le (Services/EnvService.cs). Nao adicione
# segredo aqui: este arquivo e versionado e vai dentro do instalador publico.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Identificacao do caixa.
#
# ATENCAO: STORE_ID e STORE_SYNC_TOKEN sao PROPRIOS DE CADA LOJA. Se duas lojas
# usarem o mesmo token, o servidor carimba as vendas das duas na mesma loja e a
# conferencia de estoque para de fechar.
TENANT_ID=
STORE_ID=
STORE_SYNC_TOKEN=
TERMINAL_NAME=Caixa 1
