# Configuracao do caixa (PDV).
#
# Este arquivo vai DENTRO do instalador e vira o .env numa instalacao nova.
# Em atualizacao ele nunca sobrescreve o .env que ja existe.
#
# NAO E PRECISO PREENCHER NADA AQUI para o caixa funcionar.
#
# O endereco e a chave publica da nuvem ja vem embutidos no programa
# (Services/EnvService.cs). Nao repita esses valores aqui: o que estiver escrito
# neste arquivo VENCE o que esta no programa, entao uma copia esquecida aqui
# passaria a apontar a maquina para um servidor antigo.

# Nome deste caixa, so para identificar a venda no historico (ex.: Caixa 1, Caixa 2).
TERMINAL_NAME=Caixa 1


# =====================================================================
# QUAL LOJA E ESTE CAIXA  --  nao preencha nada aqui embaixo
# =====================================================================
#
# A maquina descobre a loja sozinha no primeiro login feito com internet: o usuario
# do caixa (ex.: japao@padaria.com) ja tem a loja no cadastro, e o servidor entrega
# a esta maquina uma credencial propria, guardada fora desta pasta.
#
# STORE_SYNC_TOKEN e a credencial de ESCRITA. Ela nunca vai no instalador nem no
# programa: ja vazou uma vez assim, num repositorio publico, e foi preciso trocar
# o token das tres lojas.
#
# As linhas abaixo existem so por compatibilidade com maquinas antigas.
# Numa instalacao nova, deixe VAZIAS.

STORE_SYNC_TOKEN=
STORE_ID=

# Opcional: a rede tambem vem do login. So preencha se souber por que precisa.
TENANT_ID=

# Opcional: aponta a maquina para outro servidor. Vazio = o servidor de sempre.
SUPABASE_URL=
SUPABASE_ANON_KEY=
