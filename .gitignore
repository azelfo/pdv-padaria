# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Modelo sem valores, usado pelo instalador. Nao tem segredo, entao e versionado.
!PdvPadaria/.env.exemplo

# Tokens de sincronizacao em texto puro, para a troca manual em cada caixa.
TOKENS-NOVOS-LEIA.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel

# .NET / WPF build artifacts (PdvPadaria desktop app)
[Bb]in/
[Oo]bj/
*.user

# Pasta de trabalho temporaria (contem segredos: tokens, anon key)
scratch/
graphify-out/

# Instalador do .NET Framework 4.8 embutido no setup offline (116MB - baixado localmente)
PdvPadaria/redist/

# Instalador Completo (~119MB, com .NET embutido): acima do limite de 100MB do GitHub.
# Gerado localmente com: ISCC /DOFFLINE setup.iss
PdvPadaria/Output/Setup_PadariaVenancio_Completo.exe
